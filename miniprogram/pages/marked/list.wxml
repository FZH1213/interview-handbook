<!--pages/marked/list.wxml-->
<view class="marked-container">
  <view class="header">
    <text class="header-title">{{title}} ({{questions.length}})</text>
  </view>

  <view wx:if="{{questions.length === 0}}" class="empty">
    <text class="empty-text">暂无标记题目</text>
  </view>

  <view wx:else class="question-list">
    <view class="question-item" wx:for="{{questions}}" wx:key="index" bindtap="showQuestionDetail" data-index="{{item.index}}">
      <view class="question-index">{{item.index}}</view>
      <view class="question-title">{{item.title}}</view>
      <view class="remove-btn" data-index="{{item.index}}" catchtap="removeQuestion">×</view>
    </view>
  </view>
</view>

<!-- 题目详情弹窗 -->
<question-detail
  show="{{showDetail}}"
  question="{{currentQuestion}}"
  bind:close="closeQuestionDetail"
/>