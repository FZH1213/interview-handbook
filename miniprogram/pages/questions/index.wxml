<!--pages/questions/index.wxml-->
<view class="container">
  <view class="header">
    <text class="title">前端面试题</text>
    <text class="subtitle">选择你想复习的模块</text>
  </view>

  <view class="modules">
    <view
      class="module-card"
      wx:for="{{modules}}"
      wx:key="id"
      data-path="{{item.path}}"
      bindtap="navigateToModule"
    >
      <image class="module-icon module-icon-{{item.id}}" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="module-info">
        <text class="module-title">{{item.title}}</text>
        <text class="module-desc">{{item.desc}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>