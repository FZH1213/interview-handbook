/* pages/questions/index.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f5f5 0%, #ffffff 100%);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.modules {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.module-card {
  display: flex;
  align-items: center;
  background: white;
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.module-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.module-icon-basic {
  width: 54rpx;
  height: 64rpx;
  padding: 0 20rpx;
}

.module-info {
  flex: 1;
}

.module-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.module-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.arrow {
  font-size: 48rpx;
  color: #ccc;
}