<!--pages/summary/index.wxml-->
<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{hasUserInfo}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">
        <text class="avatar-text">获取头像</text>
      </view>
    </button>

    <input
      class="nickname-input"
      type="nickname"
      placeholder="点击设置昵称"
      value="{{userInfo.nickName || ''}}"
      bindchange="onNicknameChange"
    />
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-card mastered" bindtap="goToMastered">
      <view class="stat-icon">✓</view>
      <view class="stat-info">
        <text class="stat-number">{{mastered}}</text>
        <text class="stat-label">已摸清</text>
      </view>
      <text class="stat-arrow">›</text>
    </view>

    <view class="stat-card to-improve" bindtap="goToToImprove">
      <view class="stat-icon">!</view>
      <view class="stat-info">
        <text class="stat-number">{{toImprove}}</text>
        <text class="stat-label">待加强</text>
      </view>
      <text class="stat-arrow">›</text>
    </view>
  </view>

  <!-- 打赏区域 -->
  <view class="donation-section">
    <view class="donation-title">☕ 支持开发者，一分也是爱。</view>
    <view class="donation-desc">如果这个小程序对你有帮助，欢迎打赏支持~</view>
    <view class="donation-qrcodes">
      <view class="qrcode-item">
        <image class="qrcode-img" src="/assets/wechat-pay.png" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
        <text class="qrcode-label">微信</text>
      </view>
      <view class="qrcode-item">
        <image class="qrcode-img" src="/assets/alipay.png" mode="aspectFit" show-menu-by-longpress="{{true}}"></image>
        <text class="qrcode-label">支付宝</text>
      </view>
    </view>

    <!-- 打赏滚动 -->
    <view class="donation-scroll">
      <view class="donation-item {{donationVisible ? 'visible' : ''}}">
        <text class="donation-name">{{donationList[currentDonation].name}}</text>
        <text class="donation-action">打赏了</text>
        <text class="donation-amount">{{donationList[currentDonation].amount}}</text>
        <text class="donation-unit">元</text>
      </view>
    </view>
  </view>
</view>