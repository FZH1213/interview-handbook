/* pages/summary/index.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(to bottom, #f5f5f5 0%, #ffffff 100%);
}

/* 用户信息区域 */
.user-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 30rpx 0;
}

.avatar-button {
  display: flex;
  justify-content: center;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  margin-bottom: 20rpx;
}

.avatar-button::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-text {
  color: white;
  font-size: 28rpx;
}

.nickname-input {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
  width: 300rpx;
  height: 60rpx;
  line-height: 60rpx;
}

/* 统计卡片 */
.stats-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  background: white;
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.stat-card:active {
  transform: scale(0.98);
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.mastered .stat-icon {
  background: #4CAF50;
  color: white;
}

.to-improve .stat-icon {
  background: #FF9800;
  color: white;
}

.stat-info {
  flex: 1;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.stat-arrow {
  font-size: 48rpx;
  color: #ccc;
}

/* 提示信息 */
.tips {
  text-align: center;
  margin-top: 80rpx;
  padding: 32rpx;
  background: #fff3cd;
  border-radius: 12rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #856404;
}

/* 打赏区域 */
.donation-section {
  margin-top: 60rpx;
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.donation-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.donation-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 20rpx;
}

.donation-qrcodes {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.qrcode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.qrcode-label {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

/* 打赏滚动 */
.donation-scroll {
  margin-top: 24rpx;
  height: 60rpx;
  overflow: hidden;
  background: #f9f9f9;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donation-item {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.donation-item.visible {
  opacity: 1;
}

.donation-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.donation-action {
  font-size: 24rpx;
  color: #999;
  margin: 0 4rpx;
}

.donation-amount {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: 600;
}

.donation-unit {
  font-size: 24rpx;
  color: #ff6b00;
}

.qrcode-tip {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 16rpx;
}