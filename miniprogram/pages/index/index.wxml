<!--pages/index/index.wxml-->
<view class="index-container">
  <view class="header">
    <view class="logo">📚</view>
    <view class="title">前端面试题库</view>
    <view class="subtitle">541道精选面试题</view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="stat-number">368</view>
      <view class="stat-label">基础题</view>
    </view>
    <view class="divider-v"></view>
    <view class="stat-item">
      <view class="stat-number">173</view>
      <view class="stat-label">进阶题</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goToBasic">
      <view class="menu-icon">📘</view>
      <view class="menu-content">
        <view class="menu-title">前端面试题完整汇总</view>
        <view class="menu-desc">368道基础面试题，涵盖HTML、CSS、JS等</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToAdvanced">
      <view class="menu-icon">🚀</view>
      <view class="menu-content">
        <view class="menu-title">进阶面试题汇总</view>
        <view class="menu-desc">173道进阶面试题，深度剖析核心知识点</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <text>每天记一点</text>
  </view>
</view>