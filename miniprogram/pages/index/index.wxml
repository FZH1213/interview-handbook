<!--pages/index/index.wxml-->
<view class="index-container">
  <view class="header">
    <view class="logo">🖊️</view>
    <view class="title">前端面试题库</view>
    <view class="subtitle">711道精选面试题</view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="stat-number">538</view>
      <view class="stat-label">基础题</view>
    </view>
    <view class="divider-v"></view>
    <view class="stat-item">
      <view class="stat-number">173</view>
      <view class="stat-label">进阶题</view>
    </view>
  </view>

  <!-- 邀请码验证 -->
  <view class="invite-section">
    <view class="invite-box">
      <input
        class="invite-input"
        id="input0"
        type="number"
        maxlength="1"
        value="{{code0}}"
        data-index="0"
        bindinput="onCodeInput"
        focus="{{focusIndex === 0}}"
      />
      <input
        class="invite-input"
        id="input1"
        type="number"
        maxlength="1"
        value="{{code1}}"
        data-index="1"
        bindinput="onCodeInput"
        focus="{{focusIndex === 1}}"
      />
      <input
        class="invite-input"
        id="input2"
        type="number"
        maxlength="1"
        value="{{code2}}"
        data-index="2"
        bindinput="onCodeInput"
        focus="{{focusIndex === 2}}"
      />
      <input
        class="invite-input"
        id="input3"
        type="number"
        maxlength="1"
        value="{{code3}}"
        data-index="3"
        bindinput="onCodeInput"
        focus="{{focusIndex === 3}}"
      />
    </view>
    <view class="error-msg">{{errorMsg || '请输入邀请码'}}</view>
  </view>

  <view class="footer">
    <text>· 每天记一点 ·</text>
  </view>
</view>