<!--pages/index/index.wxml-->
<view class="index-container">
  <view class="header">
    <view class="logo">📚</view>
    <view class="title">前端面试题库</view>
    <view class="subtitle">541道精选面试题</view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <view class="stat-number">368</view>
      <view class="stat-label">基础题</view>
    </view>
    <view class="divider-v"></view>
    <view class="stat-item">
      <view class="stat-number">173</view>
      <view class="stat-label">进阶题</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goToQuestions">
      <view class="menu-icon">📘</view>
      <view class="menu-content">
        <view class="menu-title">面试题</view>
        <view class="menu-desc">541道精选面试题，随时复习</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-item" bindtap="goToSummary">
      <view class="menu-icon">📊</view>
      <view class="menu-content">
        <view class="menu-title">学习总结</view>
        <view class="menu-desc">查看学习进度，标记重点题目</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="footer">
    <text>每天记一点</text>
  </view>
</view>