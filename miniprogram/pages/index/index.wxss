/* pages/index/index.wxss - 莫兰迪色系首页 */

.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #EBE6DE 0%, #F5F1EB 100%);
  padding: 80rpx 48rpx;
}

.header {
  text-align: center;
  padding: 80rpx 0;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.title {
  font-size: 52rpx;
  font-weight: 500;
  color: #3D3A36;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A958F;
  letter-spacing: 2rpx;
}

.stats {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  margin: 48rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 54, 0.06);
  border: 1rpx solid rgba(232, 228, 224, 0.5);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  font-size: 72rpx;
  font-weight: 500;
  color: #877a6c;
  letter-spacing: 2rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #9A958F;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.divider-v {
  width: 1rpx;
  height: 100rpx;
  background: linear-gradient(180deg, transparent, #E8E4E0, transparent);
}

/* 邀请码验证区域 */
.invite-section {
  margin-top: 80rpx;
  text-align: center;
}

.invite-box {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.invite-input {
  width: 88rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E8E4E0;
  font-size: 48rpx;
  text-align: center;
  color: #3D3A36;
  font-weight: 500;
}

.invite-input:focus {
  border-color: #877a6c;
  box-shadow: 0 0 0 4rpx rgba(135, 122, 108, 0.1);
}

.error-msg {
  height: 40rpx;
  line-height: 40rpx;
  margin-top: 0;
  font-size: 26rpx;
  color: #C4A5A5;
  letter-spacing: 1rpx;
}

.footer {
  text-align: center;
  padding: 80rpx 48rpx 48rpx;
  color: #9A958F;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}