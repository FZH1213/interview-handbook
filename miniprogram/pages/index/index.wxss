/* pages/index/index.wxss - 莫兰迪色系首页 */

.index-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #EBE6DE 0%, #F5F1EB 100%);
  padding: 80rpx 48rpx;
}

.header {
  text-align: center;
  padding: 80rpx 0;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.9;
}

.title {
  font-size: 52rpx;
  font-weight: 500;
  color: #3D3A36;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A958F;
  letter-spacing: 2rpx;
}

.stats {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx;
  margin: 48rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 54, 0.06);
  border: 1rpx solid rgba(232, 228, 224, 0.5);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  font-size: 72rpx;
  font-weight: 500;
  color: #A69F98;
  letter-spacing: 2rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #9A958F;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.divider-v {
  width: 1rpx;
  height: 100rpx;
  background: linear-gradient(180deg, transparent, #E8E4E0, transparent);
}

.menu {
  margin-top: 48rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(61, 58, 54, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.menu-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.menu-item:nth-child(1)::before {
  background: linear-gradient(180deg, #8B9DAA 0%, #7A8B99 100%);
}

.menu-item:nth-child(2)::before {
  background: linear-gradient(180deg, #C4A5A5 0%, #A88888 100%);
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(61, 58, 54, 0.08);
}

.menu-icon {
  font-size: 72rpx;
  margin-right: 32rpx;
  margin-left: 16rpx;
  opacity: 0.95;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #3D3A36;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #9A958F;
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  font-size: 48rpx;
  color: #C4B7A6;
  opacity: 0.6;
}

.footer {
  text-align: center;
  padding: 48rpx;
  color: #9A958F;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}