/* pages/basic/content.wxss - 莫兰迪蓝色系基础面试题页面 */

.content-container {
  padding-bottom: 48rpx;
}

.search-box {
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(61, 58, 54, 0.04);
  border-bottom: 1rpx solid rgba(232, 228, 224, 0.4);
}

.search-input {
  background: #F5F1EB;
  border-radius: 48rpx;
  padding: 10rpx 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E4E0;
  color: #3D3A36;
}

.search-input::placeholder {
  color: #9A958F;
}

.chapter-nav {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(232, 228, 224, 0.4);
}

.chapter-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  background: #F5F1EB;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #6B6560;
  margin: 0 12rpx;
  border: 1rpx solid #E8E4E0;
  transition: all 0.3s ease;
}

.chapter-item.active {
  background: #8B9DAA;
  color: #FFFFFF;
  border-color: #8B9DAA;
  box-shadow: 0 4rpx 16rpx rgba(139, 157, 170, 0.3);
}

.question-list {
  padding: 24rpx;
}

.question-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(61, 58, 54, 0.04),
              0 2rpx 6rpx rgba(61, 58, 54, 0.02);
  border: 1rpx solid rgba(232, 228, 224, 0.5);
  transition: all 0.3s ease;
}

.question-card:active {
  transform: scale(0.99);
}

.question-header {
  display: flex;
  align-items: center;
}

.question-number {
  background: linear-gradient(135deg, #8B9DAA 0%, #7A8B99 100%);
  color: #FFFFFF;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(139, 157, 170, 0.3);
}

.question-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #3D3A36;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

.question-toggle {
  font-size: 24rpx;
  color: #8B9DAA;
  transition: transform 0.3s ease;
  margin-left: 12rpx;
  opacity: 0.6;
}

.question-toggle.expanded {
  transform: rotate(180deg);
}

.question-detail {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E8E4E0;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.quick-note {
  background: linear-gradient(135deg, #EEF3F6 0%, #E8EEF3 100%);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin: 28rpx 0;
  border-left: 6rpx solid #8B9DAA;
  box-shadow: 0 4rpx 12rpx rgba(139, 157, 170, 0.15);
}

.quick-note-title {
  font-size: 26rpx;
  color: #7A8B99;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
}

.quick-note-content {
  font-size: 26rpx;
  color: #5A5650;
  line-height: 1.8;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
}

.quick-note-content text {
  display: block;
}

.content-text {
  font-size: 28rpx;
  color: #6B6560;
  line-height: 1.9;
  margin: 28rpx 0;
  letter-spacing: 0.5rpx;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
}

.content-text text {
  display: block;
}

.follow-up {
  background: linear-gradient(135deg, #FBF9F6 0%, #F8F5F0 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  border-left: 4rpx solid #C4A989;
}

.follow-up-title {
  font-size: 26rpx;
  color: #C4A989;
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.follow-up-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #E8E4E0;
}

.follow-up-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.follow-up-question {
  font-size: 26rpx;
  color: #3D3A36;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.follow-up-answer {
  font-size: 26rpx;
  color: #6B6560;
  line-height: 1.7;
}

.load-more {
  text-align: center;
  padding: 40rpx;
  color: #8B9DAA;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 88rpx;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(61, 58, 54, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8B9DAA;
  border: 1rpx solid #E8E4E0;
}