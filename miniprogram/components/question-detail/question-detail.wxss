/* components/question-detail/question-detail.wxss */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-container {
  width: 100%;
  max-width: 100vw;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #E8E4E0;
  display: flex;
  align-items: flex-start;
}

.question-number {
  background: linear-gradient(135deg, #8B9DAA 0%, #7A8B99 100%);
  color: #FFFFFF;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.question-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #3D3A36;
  line-height: 1.5;
  margin-right: 16rpx;
  word-wrap: break-word;
  word-break: break-all;
  overflow: hidden;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #9A958F;
  line-height: 1;
  flex-shrink: 0;
}

.modal-content {
  flex: 1;
  overflow-y: auto;
}

.content-text {
  padding: 32rpx;
  font-size: 28rpx;
  color: #6B6560;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
}

.content-text text {
  display: block;
}

.follow-up {
  background: linear-gradient(135deg, #FBF9F6 0%, #F8F5F0 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  border-left: 4rpx solid #C4A989;
}

.follow-up-title {
  font-size: 26rpx;
  color: #C4A989;
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.follow-up-item {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #E8E4E0;
}

.follow-up-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.follow-up-question {
  font-size: 26rpx;
  color: #3D3A36;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.follow-up-answer {
  font-size: 26rpx;
  color: #6B6560;
  line-height: 1.7;
}

.modal-footer {
  padding: 24rpx 64rpx 36rpx;
  border-top: 1rpx solid #E8E4E0;
  display: flex;
  justify-content: center;
  gap: 36rpx;
}

.mark-btn {
  width: 200rpx;
  height: 64rpx;
  font-size: 22rpx;
  border-radius: 36rpx;
  border: 1rpx solid #E8E4E0;
  background: #FFFFFF;
}

.mark-btn::after {
  border: none;
  font-weight: 500;
}

.mark-btn.mastered {
  color: #9A958F;
  border-color: #E8E4E0;
}

.mark-btn.mastered.active {
  background: #4CAF50;
  color: #FFFFFF;
  border-color: #4CAF50;
}

.mark-btn.to-improve {
  color: #9A958F;
  border-color: #E8E4E0;
}

.mark-btn.to-improve.active {
  background: #FF9800;
  color: #FFFFFF;
  border-color: #FF9800;
}

.mark-btn:active {
  opacity: 0.8;
}